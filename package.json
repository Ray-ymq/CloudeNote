{
  "name": "cloudnote-obsidian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node config/esbuild.mjs --watch",
    "build": "tsc -p config/tsconfig.json --noEmit && node config/esbuild.mjs",
    "test": "vitest run --config config/vitest.config.ts",
    "check": "tsc -p config/tsconfig.json --noEmit",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "latest",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1"
  }
}
